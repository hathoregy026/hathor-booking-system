# PostgreSQL — Supabase transaction pooler (port 6543) for app runtime
# URL-encode @ in password as %40. Include pgbouncer=true for Prisma.
# Pool params (also overridable via env below):
#   connection_limit=5  pool_timeout=15  connect_timeout=10
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require&connection_limit=5&pool_timeout=15&connect_timeout=10"

# Optional pool overrides (lib/database-config.ts + lib/pg-pool.ts)
# DATABASE_CONNECTION_LIMIT=5
# DATABASE_POOL_TIMEOUT=15
# DATABASE_CONNECT_TIMEOUT=10
# DATABASE_IDLE_TIMEOUT_MS=10000

# Session pooler (port 5432) — only if you run a single server instance; limited to ~15 connections
# DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require"

# Direct connection for Prisma CLI migrations (db.PROJECT_REF.supabase.co:5432).
# DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"

# --- Dashboard sign-in (/admin) ----------------------------------------------
# Accounts are per person (email + password + authenticator app) and are
# created with:  npm run admin:users -- create --email you@hathorcruise.com --name "You"
# See docs/admin-login.md. Both values below are REQUIRED; sign-in refuses to
# work without them. Use different values for local and production.

# Signs session cookies. 64 hex chars: openssl rand -hex 32
# Changing it signs everyone out immediately.
ADMIN_SESSION_SECRET="replace-with-openssl-rand-hex-32"

# Encrypts authenticator secrets at rest (AES-256-GCM). 64 hex chars:
# openssl rand -hex 32. Keep it stable and backed up: if it is lost or
# changed, every account must re-scan a QR code (npm run admin:users -- reset-mfa).
ADMIN_MFA_ENCRYPTION_KEY="replace-with-openssl-rand-hex-32"

# Legacy fallback signer for booking/guest links only (see below). It no
# longer opens the dashboard.
ADMIN_PASSWORD="your-legacy-fallback-secret"

# Optional - lets ?fresh=<token> trigger a cache purge while logged out.
# Leave unset and only a signed-in admin can purge.
# CACHE_PURGE_TOKEN="your-cache-purge-token"

# Required for POST /api/cron/cleanup — use a long random string (e.g. openssl rand -hex 32)
# Send as: Authorization: Bearer <CRON_SECRET>
CRON_SECRET="your-cron-secret"

# Optional — signs booking hold tokens (falls back to CRON_SECRET, then ADMIN_PASSWORD)
# BOOKING_HOLD_SECRET="your-booking-hold-secret"

# Optional dedicated signer for long-lived guest booking links. Falls back to
# BOOKING_HOLD_SECRET / ADMIN_SESSION_SECRET / CRON_SECRET / ADMIN_PASSWORD.
# BOOKING_ACCESS_SECRET="your-booking-access-secret"

# Resend (https://resend.com) — transactional email
RESEND_API_KEY="re_xxxxxxxx"
# Monitored mailbox until receiving is activated
RESEND_REPLY_TO="reservations@hathorcruise.com"
# Verified sender in Resend (use onboarding@resend.dev for testing)
RESEND_FROM_EMAIL="Hathor Dahabiya <reservations@hathorcruise.com>"
# Receives new-booking admin alerts and test emails (must match Resend account email in sandbox)
ADMIN_EMAIL="hathoregy026@gmail.com"

# Booking email conversations: leave disabled until migration and webhook are deployed.
RESEND_INBOUND_ENABLED="false"
BOOKING_REPLY_NOTIFICATION_EMAIL="reservations@hathorcruise.com"
# Add the Resend webhook signing secret in Vercel, never in Git.
# RESEND_WEBHOOK_SECRET="whsec_..."
# Full-access Resend key for fetching received messages and attachments.
# Optional when RESEND_API_KEY already has Full access.
# RESEND_RECEIVING_API_KEY="re_..."

# Optional — canonical public site URL (used for email image links and uploads)
NEXT_PUBLIC_SITE_URL="https://hathor-booking-system.vercel.app"

# Google Analytics Data API — admin /admin/analytics only (server-side).
# Numeric GA4 property ID (Admin → Property details). Not the G- measurement ID.
# GA_PROPERTY_ID="123456789"
# Service-account JSON as one line, or base64 of that JSON. Never commit the real value.
# Grant the service account Viewer on the GA4 property, and enable Analytics Data API.
# GOOGLE_APPLICATION_CREDENTIALS_JSON="{}"

# Supabase (Project Settings → API)
# Storage buckets: website-images (site), email-images (email template images)
SUPABASE_URL="https://YOUR_PROJECT_REF.supabase.co"
# Required for server-side image uploads in production (Settings → API → service_role)
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"
# Optional — used only if service role key is not set
SUPABASE_ANON_KEY="your-anon-key"

# Guest reviews (home + room pages). Server-only key with "Places API (New)" enabled.
# GOOGLE_PLACES_API_KEY=""
# Optional: pin the Google listing instead of finding it by name.
# GOOGLE_PLACE_ID=""
# Optional: replaces the built-in Hathor listing on Tripadvisor.
# TRIPADVISOR_URL=""
# Optional: Tripadvisor API key (server-only, from terra.tripadvisor.com) for live Tripadvisor reviews.
# TRIPADVISOR_API_KEY=""
# Optional: Tripadvisor location ID (otherwise read from the listing URL).
# TRIPADVISOR_LOCATION_ID=""
# Contact/charter CAPTCHA. Use real Cloudflare keys for deployment.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
TURNSTILE_ALLOWED_HOSTNAMES=www.hathorcruise.com,hathorcruise.com
