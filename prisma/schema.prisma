// Hathor Booking System
// All DateTime values are stored as UTC instants (timezone-proof).

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

// Pool tuning (applied at runtime in lib/database-config.ts + lib/pg-pool.ts):
// Append to DATABASE_URL or set env vars:
//   connection_limit=5  — max clients in the shared pool
//   pool_timeout=15     — seconds to wait when acquiring a connection
//   connect_timeout=10  — seconds to wait when opening a new connection
// Migrate URL: prisma.config.ts (DIRECT_URL / DATABASE_URL)
datasource db {
  provider = "postgresql"
}

enum BookingStatus {
  PENDING_HOLD
  REQUESTED
  CONFIRMED
  CANCELLED
  EXPIRED
}

enum BookingPaymentStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  PARTIALLY_REFUNDED
  REFUNDED
  FAILED
}

enum ContentSection {
  HERO
  ABOUT
  ITINERARIES
  ROOMS
  WELLNESS
  GASTRONOMY
  CHARTER
  CONTACT
}

model Cruise {
  id             String    @id @default(cuid())
  name           String
  description    String?
  slug           String    @unique
  imageUrl       String?
  basePriceCents Int       @default(0)
  ports          String?
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  schedules   CruiseSchedule[]
  rooms       Room[] @relation("CruiseRooms")
  legacyRooms Room[] @relation("LegacyCruiseRoom")
  ticketTypes TicketType[]

  @@index([deletedAt])
}

model CruiseSchedule {
  id            String   @id @default(cuid())
  cruiseId      String
  departureTime DateTime
  arrivalTime   DateTime
  isBookable    Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cruise       Cruise        @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  bookingRooms BookingRoom[]
  sectors ScheduleSector[]

  @@index([cruiseId])
}

model Room {
  id              String    @id @default(cuid())
  cruiseId        String?
  name            String
  roomNumber      String? @unique
  sizeSqm         Int @default(22)
  roomType        String?
  priceMultiplier Float     @default(1)
  capacity        Int
  description     String?
  deletedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  cruise       Cruise?       @relation("LegacyCruiseRoom", fields: [cruiseId], references: [id], onDelete: Restrict)
  voyages      Cruise[]      @relation("CruiseRooms")
  bookingRooms BookingRoom[]
  allocations InventoryAllocation[]

  @@index([cruiseId])
  @@index([deletedAt])
}

model TicketType {
  id          String   @id @default(cuid())
  cruiseId    String
  name        String
  description String?
  priceCents  Int
  roomType    String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  cruise         Cruise          @relation(fields: [cruiseId], references: [id], onDelete: Cascade)
  bookingTickets BookingTicket[]

  @@index([cruiseId])
  @@unique([cruiseId, roomType])
}

model Booking {
  id               String               @id @default(cuid())
  cruiseScheduleId String
  status           BookingStatus        @default(PENDING_HOLD)
  paymentStatus    BookingPaymentStatus @default(PENDING)
  idempotencyKey   String?              @unique
  holdExpiresAt    DateTime?
  customerEmail    String?
  customerName     String?
  customerPhone    String?
  adultCount       Int?
  childCount       Int?
  specialRequests  String?
  marketingOptIn   Boolean              @default(false)
  marketingOptInAt DateTime?
  termsAcceptedAt  DateTime?
  firstName        String?
  lastName         String?
  country          String?
  paymentMethod    String?
  requestedAt      DateTime?
  acceptedAt       DateTime?
  confirmedAt      DateTime?
  cancelledAt      DateTime?
  cancellationFeeCents Int?
  cancellationReason String?
  requestFingerprint String?
  guestEmailStatus String @default("PENDING")
  adminEmailStatus String @default("PENDING")
  totalPriceCents  Int?
  currency         String               @default("USD")
  priceSnapshotAt  DateTime?
  deletedAt        DateTime?
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt

  cruiseSchedule CruiseSchedule  @relation(fields: [cruiseScheduleId], references: [id])
  bookingRooms   BookingRoom[]
  bookingTickets BookingTicket[]
  guests BookingGuest[]
  payments BookingPayment[]
  paymentSchedule BookingPaymentSchedule[]

  @@index([cruiseScheduleId, status])
  @@unique([id, cruiseScheduleId])
  @@index([deletedAt])
  @@index([deletedAt, createdAt])
  @@index([status, deletedAt, createdAt])
}

model ApiRateLimit {
  key       String   @id
  count     Int
  resetAt   DateTime
  updatedAt DateTime @updatedAt

  @@index([resetAt])
}

model BookingRoom {
  roomIndex Int @default(0)
  id               String   @id @default(cuid())
  bookingId        String
  roomId           String
  cruiseScheduleId String
  unitPriceCents   Int?
  adults           Int @default(1)
  children         Int @default(0)
  createdAt        DateTime @default(now())

  booking        Booking        @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  room           Room           @relation(fields: [roomId], references: [id])
  cruiseSchedule CruiseSchedule @relation(fields: [cruiseScheduleId], references: [id])
  allocation InventoryAllocation?

  @@unique([bookingId, roomId])
  @@unique([bookingId, roomIndex])
  @@index([roomId, cruiseScheduleId])
}

model SailingSector {
  id String @id @default(cuid())
  startsAt DateTime @unique
  endsAt DateTime
  schedules ScheduleSector[]
}

model ScheduleSector {
  cruiseScheduleId String
  sectorId String
  schedule CruiseSchedule @relation(fields: [cruiseScheduleId], references: [id], onDelete: Cascade)
  sector SailingSector @relation(fields: [sectorId], references: [id], onDelete: Restrict)
  @@id([cruiseScheduleId, sectorId])
}

model InventoryAllocation {
  id String @id @default(cuid())
  roomId String
  bookingRoomId String? @unique
  startsAt DateTime
  endsAt DateTime
  state String
  active Boolean @default(true)
  expiresAt DateTime?
  blockKey String?
  reason String?
  createdAt DateTime @default(now())
  room Room @relation(fields: [roomId], references: [id], onDelete: Restrict)
  bookingRoom BookingRoom? @relation(fields: [bookingRoomId], references: [id], onDelete: Cascade)
  @@index([roomId, startsAt, endsAt])
  @@index([blockKey])
}

model BookingGuest {
  id String @id @default(cuid())
  bookingId String
  roomIndex Int
  fullName String
  isChild Boolean @default(false)
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@index([bookingId])
}

model BookingPayment {
  id String @id @default(cuid())
  bookingId String
  reference String @unique
  method String
  kind String @default("RECEIPT")
  amountCents Int
  currency String @default("USD")
  receivedAt DateTime
  recordedAt DateTime @default(now())
  recordedBySession String?
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Restrict)
  @@index([bookingId])
}

model BookingPaymentSchedule {
  id String @id @default(cuid())
  bookingId String
  milestone String
  dueAt DateTime?
  cumulativeCents Int
  booking Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  @@unique([bookingId, milestone])
}

model BookingTicket {
  id             String   @id @default(cuid())
  bookingId      String
  ticketTypeId   String
  quantity       Int      @default(1)
  unitPriceCents Int?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  booking    Booking    @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  ticketType TicketType @relation(fields: [ticketTypeId], references: [id])

  @@unique([bookingId, ticketTypeId])
}

model SiteContent {
  id        String         @id @default(cuid())
  section   ContentSection @unique
  title     String
  subtitle  String?
  bodyText  String?
  imageUrl  String?
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
}

model BlogPost {
  id          String   @id @default(cuid())
  slug        String   @unique
  title       String
  excerpt     String
  content     String   @default("")
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([publishedAt])
}

model AdminProfile {
  id                String   @id
  displayName       String   @default("Admin")
  avatarUrl         String?
  lastSeenBookingAt DateTime @default(now())
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

model EmailTemplate {
  id              String   @id @default(cuid())
  name            String   @unique
  subject         String
  logoUrl         String?
  heroImageUrl    String?
  primaryColor    String   @default("#C9A96E")
  backgroundColor String   @default("#FAF8F5")
  heroHeading     String?
  bodyText        String?
  updatedAt       DateTime @updatedAt
}

model SiteImage {
  id           String   @id @default(cuid())
  name         String
  altText      String
  url          String
  category     String
  pagePath     String
  displayOrder Int      @default(0)
  isActive     Boolean  @default(true)
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())

  @@index([pagePath, category])
}

/**
 * Temporary key/value store (hero logo tuner). Safe to drop later.
 */
model SiteSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
