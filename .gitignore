# local audit / measure dumps (never ship)
/lighthouse-*.json
/PROJECT-FILES-GPT.md
/build-output.txt
/scripts/out-*
/scripts/_tmp-*
/SCROLL-SYSTEM-AUDIT*.md
/public/branding/_hieroglyph-tmp.webp
/public/fonts/**/._*
/public/media/hathor/videos/*.llc

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# frozen local scroll reveal reference (never commit)
/_local/scroll-reveal-effect/

# typescript
*.tsbuildinfo
next-env.d.ts

.vercel

# local Claude redesign bundles (never deploy)
/redesign/

# local snapshot of current admin dashboard (restore source; never deploy)
/OLD DASHBOARD BACK UP/

